# Copy this to .env and fill in your bot token.
# The Firebase credentials are the same public ones already in the app
# (safe to include — Firestore rules gate access by account name, not the key).
BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated Telegram user IDs allowed to use the bot. Leave unset to allow everyone.
ALLOWED_USER_IDS=
# Comma-separated Telegram chat IDs (groups/channels) the bot responds to. Leave unset to not restrict by chat.
ALLOWED_CHAT_IDS=
